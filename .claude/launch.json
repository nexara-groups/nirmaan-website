{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Python Static Server",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    },
    {
      "name": "Wrangler (Cloudflare Pages)",
      "runtimeExecutable": "wrangler",
      "runtimeArgs": ["dev", "--port", "8787"],
      "port": 8787
    }
  ]
}
